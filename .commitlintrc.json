{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [2, "always", [
      "feat", "fix", "chore", "docs", "style",
      "refactor", "test", "perf", "ci", "build", "revert"
    ]],
    "subject-max-length": [2, "always", 100],
    "body-max-line-length": [1, "always", 120]
  }
}
